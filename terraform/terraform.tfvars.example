# Copy this file to terraform.tfvars locally. It is ignored by Git.
# Prefer TF_VAR_nhn_user_name, TF_VAR_nhn_tenant_id, TF_VAR_nhn_api_password,
# and TF_VAR_nhn_auth_url for credentials instead of writing them to this file.

network_id       = "existing-company-vpc-uuid"
key_pair_name    = "existing-ssh-keypair-name"
ssh_public_key_path = "C:/Users/YOUR_WINDOWS_USER/.ssh/kimjaehwan_nhn.pub"
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"

# Change only after confirming the exact names and capacity in the console.
availability_zone = "kr-pub-a"
root_volume_gb    = 30

# Optional: set only when the company VPC displays a specific subnet UUID.
# subnet_id = "existing-subnet-uuid"

# Defaults use Ubuntu Server 24.04.3 LTS (2026.03.10) and m2.c2m4 (2 vCPU, 4 GB).
# Override only if your Pangyo project has a different approved image or flavor.
# image_name  = "Ubuntu Server 24.04.3 LTS (2026.03.10)"
# flavor_name = "m2.c2m4"
